<?xml version="1.0" encoding="utf-8"?>
<!--
    لوحة ودجات «طمأنينة» — الوضع الداكن.

    نسخة طبق الأصل من `AppSkin.dark`: أرضية سوداء كما طلبها المستخدم للتطبيق،
    لا بنّي ليليّ. الأسماء هي نفسها في values/widget_tokens.xml، فلا يعرف
    التخطيط ولا الرسم أيّ وضع يعمل فيه.
-->
<resources>

    <!-- أسود، ليطابق أرضية التطبيق في الوضع الداكن. -->
    <color name="widget_surface">#FF0D0D0D</color>

    <color name="widget_surface_raised">#FF1E1811</color>

    <color name="widget_hairline">#FF3A2C1C</color>

    <color name="widget_ink">#FFFFF7E7</color>

    <color name="widget_ink_soft">#FFCBB08B</color>

    <!-- ذهبي أفتح: الغامق لا يُقرأ على أسود. -->
    <color name="widget_accent">#FFD9BE8F</color>

    <!-- حبر يُكتب فوق الذهبي: داكن في الوضعين، فالذهبي فاتح في كليهما. -->
    <color name="widget_on_accent">#FF1A1A1A</color>

    <color name="widget_dot_idle">#FF2A2119</color>

</resources>
