<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية موحّدة لكل الويدجتات الجديدة: تدرّج بنّي ليلي بحدّ ذهبي رفيع،
     مطابق لهوية «طمأنينة» على شاشة البدء أيًّا كانت خلفية المستخدم. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="18dp" />
    <gradient
        android:angle="135"
        android:centerColor="#20190F"
        android:endColor="#15110B"
        android:startColor="#2B2114" />
    <stroke
        android:width="1dp"
        android:color="#C9A46A" />
</shape>
