<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت «آية اليوم» (4×2): نصّ الآية يتمدّد في المساحة المتاحة ويُختصر عند الضيق. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tw_background"
    android:layoutDirection="rtl"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tw_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:maxLines="1"
            android:text="@string/tw_daily_ayah_label"
            android:textColor="@color/tw_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tw_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:lineSpacingMultiplier="1.25"
            android:maxLines="4"
            android:text="@string/tw_ayah_fallback"
            android:textColor="@color/tw_ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tw_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:maxLines="1"
            android:text="@string/tw_ayah_fallback_source"
            android:textColor="@color/tw_ink_soft"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
