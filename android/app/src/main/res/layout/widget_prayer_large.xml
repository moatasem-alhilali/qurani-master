<?xml version="1.0" encoding="utf-8"?>
<!--
    الصلاة القادمة.

    كان الاسم والوقت في صفّ نصفين متقابلين (الوقت يسارًا والاسم يمينًا)، وفي
    خليّة ‎2×1‎ يتصادمان. صار الاسم والوقت سطرًا واحدًا متلاصقًا يُقرأ كجملة،
    والمتبقّي تحته — وهو المعلومة التي يُفتح الودجت لأجلها فعلًا.

    وحُذفت أيقونة التطبيق: ‎@mipmap/ic_launcher‎ بمقاس ‎14dp‎ كانت لطخة لا شعارًا.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_background"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding"
    android:textDirection="rtl">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="end"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:text="الصلاة القادمة"
        android:textColor="@color/widget_ink_soft"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="true"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="الفجر"
            android:textColor="@color/widget_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:text="04:18 ص"
            android:textColor="@color/widget_accent"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text="بعد 34 د"
        android:textColor="@color/widget_ink_soft"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text="طمأنينة"
        android:textColor="@color/widget_ink_soft"
        android:textSize="9sp" />
</LinearLayout>
