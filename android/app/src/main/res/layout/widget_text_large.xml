<?xml version="1.0" encoding="utf-8"?>
<!--
    الذكر والآية.

    النصّ هو البطل هنا، فيأخذ كل المساحة الباقية (‎layout_weight‎) بدل ارتفاع
    ثابت يقصّ الأذكار الطويلة. العنوان والمصدر سطران رفيعان يحيطان به.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding"
    android:textDirection="rtl">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="end"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:text="ذكر اليوم"
        android:textColor="@color/widget_ink_soft"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical|end"
        android:lineSpacingMultiplier="1.35"
        android:maxLines="5"
        android:text="لا إله إلا الله وحده لا شريك له"
        android:textColor="@color/widget_ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text="أذكار طمأنينة"
        android:textColor="@color/widget_accent"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
