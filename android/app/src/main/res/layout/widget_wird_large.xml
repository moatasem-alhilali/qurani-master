<?xml version="1.0" encoding="utf-8"?>
<!--
    ورد اليوم.

    النسبة رقم كبير بالذهبي: هي الحالة كلّها في نظرة. الملخّص تحتها بالخافت،
    ولا صندوق ثانٍ حولها — الودجت نفسه هو الصندوق.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_background"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding"
    android:textDirection="rtl">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="end"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:text="ورد اليوم"
        android:textColor="@color/widget_ink_soft"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text="60%"
        android:textColor="@color/widget_accent"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="2"
        android:text="ابدأ وردك الآن"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text="طمأنينة"
        android:textColor="@color/widget_ink_soft"
        android:textSize="9sp" />
</LinearLayout>
