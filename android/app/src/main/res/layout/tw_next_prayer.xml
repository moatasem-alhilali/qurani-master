<?xml version="1.0" encoding="utf-8"?>
<!--
  ودجت «الصلاة القادمة» (2×2).
  النصوص الافتراضية هنا تظهر في معاينة منتقي الودجات (previewLayout) قبل الإضافة.
  العدّ التنازلي Chronometer يعدّ بنفسه في الشاشة الرئيسية دون أيّ تحديث.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tw_background"
    android:layoutDirection="rtl"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tw_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:text="@string/tw_next_prayer_label"
            android:textColor="@color/tw_ink_soft"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tw_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:text="العصر"
            android:textColor="@color/tw_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tw_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:text="3:15 م"
            android:textColor="@color/tw_ink"
            android:textSize="14sp" />

        <Chronometer
            android:id="@+id/tw_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="2dp"
            android:countDown="true"
            android:layoutDirection="ltr"
            android:textColor="@color/tw_ink"
            android:textDirection="ltr"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tw_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:text="منطقة الرياض"
            android:textColor="@color/tw_ink_soft"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
