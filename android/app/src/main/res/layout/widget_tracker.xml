<?xml version="1.0" encoding="utf-8"?>
<!--
    متابعة صلوات اليوم.

    خمسة أعمدة متساوية العرض، كل عمود نقطة فوق اسمها — فالصفّ يُقرأ خريطةً
    لليوم لا قائمةً. النقطة الممتلئة ذهبية، والباقية رمادية باهتة: الفرق
    يُلتقط من بعيد دون قراءة.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_background"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding"
    android:textDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="صلوات اليوم"
            android:textColor="@color/widget_ink_soft"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="0 / 5"
            android:textColor="@color/widget_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_dot_1"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <TextView
                android:id="@+id/widget_label_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:text="الفجر"
                android:textColor="@color/widget_ink_soft"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_dot_2"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <TextView
                android:id="@+id/widget_label_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:text="الظهر"
                android:textColor="@color/widget_ink_soft"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_dot_3"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <TextView
                android:id="@+id/widget_label_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:text="العصر"
                android:textColor="@color/widget_ink_soft"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_dot_4"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <TextView
                android:id="@+id/widget_label_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:text="المغرب"
                android:textColor="@color/widget_ink_soft"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_dot_5"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <TextView
                android:id="@+id/widget_label_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:text="العشاء"
                android:textColor="@color/widget_ink_soft"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text="افتح التطبيق لتعليم ما صلّيت"
        android:textColor="@color/widget_ink_soft"
        android:textSize="10sp" />
</LinearLayout>
