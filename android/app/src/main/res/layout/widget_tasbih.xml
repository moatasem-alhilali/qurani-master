<?xml version="1.0" encoding="utf-8"?>
<!--
    المسبحة — الودجت الوحيد الذي يُستعمل لا يُقرأ فقط.

    لذلك زرّ العدّ هو أكبر عنصر فيه ومعبّأ بالذهبي كاملًا: يده تجده دون أن
    تنظر. الخرزات العشر تحته تقول أين وصل داخل العشرة الحالية، و«تصفير» نصّ
    رفيع بعيد عن الزرّ حتى لا يُضغط سهوًا.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding"
    android:textDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="المسبحة"
            android:textColor="@color/widget_ink_soft"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="تصفير"
            android:textColor="@color/widget_ink_soft"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text="سبحان الله وبحمده"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_count_pill"
            android:gravity="center"
            android:minWidth="62dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp"
            android:text="0"
            android:textColor="@color/widget_on_accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_bead_1"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <ImageView
                android:id="@+id/widget_bead_2"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <ImageView
                android:id="@+id/widget_bead_3"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <ImageView
                android:id="@+id/widget_bead_4"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <ImageView
                android:id="@+id/widget_bead_5"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <ImageView
                android:id="@+id/widget_bead_6"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <ImageView
                android:id="@+id/widget_bead_7"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <ImageView
                android:id="@+id/widget_bead_8"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <ImageView
                android:id="@+id/widget_bead_9"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />

            <ImageView
                android:id="@+id/widget_bead_10"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_bead_idle" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
