<?xml version="1.0" encoding="utf-8"?>
<!--
    قالب «عنوان + قيمة + سطر» — تتقاسمه القبلة والتاريخ الهجري ومتابعة القراءة.

    القيمة وحدها بالحبر الكامل، وما حولها بالحبر الخافت: ثلاث درجات نصّ لا
    ثلاثة صناديق، فيبقى الودجت هادئًا في خليّة صغيرة.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_background"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding"
    android:textDirection="rtl">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="end"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:text="التاريخ الهجري"
        android:textColor="@color/widget_ink_soft"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="2"
        android:text="١٢ رمضان ١٤٤٧"
        android:textColor="@color/widget_ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text="١٥ سبتمبر ٢٠٢٦"
        android:textColor="@color/widget_ink_soft"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text="طمأنينة"
        android:textColor="@color/widget_ink_soft"
        android:textSize="9sp" />
</LinearLayout>
