<?xml version="1.0" encoding="utf-8"?>
<!-- قالب «رقم كبير وسطر تحته»: يخدم القبلة والتاريخ الهجري ومتابعة القراءة.
     قالب واحد لثلاثة ويدجتات بدل ثلاثة ملفّات متطابقة تتباعد مع الوقت. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="10dp"
    android:textDirection="rtl">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:text="طمأنينة"
        android:textColor="#D4B873"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:maxLines="1"
        android:text="—"
        android:textColor="#FFF7E1"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="end"
        android:maxLines="2"
        android:text="—"
        android:textColor="#D4B873"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="end"
        android:maxLines="1"
        android:text="طمأنينة"
        android:textColor="#9C8149"
        android:textSize="8sp" />
</LinearLayout>
