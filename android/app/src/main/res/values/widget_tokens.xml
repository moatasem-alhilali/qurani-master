<?xml version="1.0" encoding="utf-8"?>
<!--
    لوحة ودجات «طمأنينة» — الوضع الفاتح.

    هذه نسخة طبق الأصل من `AppSkin.light` في التطبيق (lib/core/theme/app_skin.dart)،
    فالودجت يبدو امتدادًا للتطبيق لا تطبيقًا آخر على الشاشة.

    قبلها كان كل ملفّ تخطيط ورسم يكتب ألوانه بنفسه (‎#2B2114‎ و‎#C9A46A‎ …) فبقيت
    الودجات داكنة بنّية دائمًا مهما كان ثيم الجهاز — صندوق غريب على شاشة فاتحة.
    الآن اللون اسم واحد، ويحلّه أندرويد من هنا أو من values-night تلقائيًّا.
-->
<resources>

    <!-- الأرضية: بيضاء كما في التطبيق. -->
    <color name="widget_surface">#FFFFFFFF</color>

    <!-- سطح مرتفع داخل الودجت (خليّة، رقاقة، زرّ). -->
    <color name="widget_surface_raised">#FFF8EDD2</color>

    <!-- خطّ الشعرة الفاصل والحدّ الخارجي. -->
    <color name="widget_hairline">#FFE7DCC3</color>

    <!-- النصّ الأساسي. -->
    <color name="widget_ink">#FF1A1A1A</color>

    <!-- النصّ الثانوي: العناوين الصغيرة والتذييل. -->
    <color name="widget_ink_soft">#FF6F5636</color>

    <!-- الذهبي: يُصرف على عنصر واحد في كل ودجت لا على كل شيء. -->
    <color name="widget_accent">#FFB18C55</color>

    <!-- حبر يُكتب فوق الذهبي: داكن في الوضعين، فالذهبي فاتح في كليهما. -->
    <color name="widget_on_accent">#FF1A1A1A</color>

    <!-- نقطة/خرزة غير مكتملة. -->
    <color name="widget_dot_idle">#FFE0D5BC</color>

    <!--
        نصف قطر الزوايا.

        في values-v31 يُستبدل بقيمة النظام حتى يطابق الودجت بقيّة ودجات
        أندرويد ١٢ فما فوق، وهنا قيمة ثابتة للأجهزة الأقدم.
    -->
    <dimen name="widget_radius">20dp</dimen>

    <!-- حشو الحافة: واحد لكل الودجات حتى تتحاذى على الشاشة. -->
    <dimen name="widget_padding">14dp</dimen>

</resources>
