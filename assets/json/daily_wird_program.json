  "content_library": {
    "istighfar_text": {
      "title": "نص الاستغفار",
      "text": "أستغفر الله",
      "source": "ذكر مشروع",
      "fadhl": "الاستغفار من أجلّ الأذكار وأعظمها أثرًا على القلب."
    },
    "salawat_text": {
      "title": "نص الصلاة على النبي ﷺ",
      "text": "اللهم صل وسلم على نبينا محمد",
      "source": "ذكر مشروع",
      "fadhl": "الصلاة على النبي ﷺ من أعظم القربات."
    },
    "quran_general": {
      "title": "ورد القرآن",
      "text": "اقرأ المقدار المحدد من القرآن الكريم بخشوع وتدبر.",
      "source": "القرآن الكريم",
      "fadhl": "القرآن نور وهدى وبركة."
    },
    "dua_day_1": {
      "title": "دعاء اليوم",
      "text": "اللهم أعني على ذكرك وشكرك وحسن عبادتك",
      "source": "دعاء مشروع",
      "fadhl": "من أجمع الأدعية وأنفعها في باب العبادة."
    },
    "dua_day_2": {
      "title": "دعاء اليوم",
      "text": "رب اغفر لي وتب علي إنك أنت التواب الرحيم",
      "source": "دعاء مشروع",
      "fadhl": "دعاء جامع بين المغفرة والتوبة والرجاء."
    },
    "sleep_dua_1": {
      "title": "دعاء النوم",
      "text": "باسمك اللهم أموت وأحيا",
      "source": "صحيح البخاري",
      "fadhl": "من أذكار النوم الثابتة."
    },
    "surah_mulk": {
      "title": "سورة الملك",
      "text": "قراءة سورة الملك كاملة قبل النوم",
      "source": "القرآن الكريم",
      "fadhl": "ورد ثابت عند كثير من المسلمين ويُستحب المواظبة على القرآن."
    },
    "surah_kahf": {
      "title": "سورة الكهف",
      "text": "قراءة سورة الكهف كاملة يوم الجمعة",
      "source": "القرآن الكريم",
      "fadhl": "ورد أسبوعي مشهور ومحبب يوم الجمعة."
    },
    "morning_1": {
      "title": "ذكر الصباح 1",
      "text": "أصبحنا وأصبح الملك لله",
      "source": "ذكر مشروع",
      "fadhl": "من الأذكار المشهورة في الصباح."
    },
    "morning_2": {
      "title": "ذكر الصباح 2",
      "text": "اللهم بك أصبحنا وبك أمسينا وبك نحيا وبك نموت وإليك النشور",
      "source": "ذكر مشروع",
      "fadhl": "ذكر جامع لمعاني التوكل والافتقار."
    },
    "morning_3": {
      "title": "ذكر الصباح 3",
      "text": "رضيت بالله ربًا وبالإسلام دينًا وبمحمد ﷺ نبيًا",
      "source": "ذكر مشروع",
      "fadhl": "من الأذكار العظيمة في تجديد الرضا والإيمان."
    },
    "morning_4": {
      "title": "ذكر الصباح 4",
      "text": "حسبي الله لا إله إلا هو عليه توكلت وهو رب العرش العظيم",
      "source": "ذكر مشروع",
      "fadhl": "ذكر عظيم في التوكل واليقين."
    },
    "evening_1": {
      "title": "ذكر المساء 1",
      "text": "أمسينا وأمسى الملك لله",
      "source": "ذكر مشروع",
      "fadhl": "من أذكار المساء المشهورة."
    },
    "evening_2": {
      "title": "ذكر المساء 2",
      "text": "اللهم بك أمسينا وبك أصبحنا وبك نحيا وبك نموت وإليك المصير",
      "source": "ذكر مشروع",
      "fadhl": "من أذكار المساء الثابتة المشهورة."
    },
    "evening_3": {
      "title": "ذكر المساء 3",
      "text": "رضيت بالله ربًا وبالإسلام دينًا وبمحمد ﷺ نبيًا",
      "source": "ذكر مشروع",
      "fadhl": "ذكر عظيم في الثبات والسكينة."
    },
    "post_prayer_1": {
      "title": "ذكر بعد الصلاة 1",
      "text": "أستغفر الله، أستغفر الله، أستغفر الله",
      "source": "ذكر مشروع",
      "fadhl": "من أذكار ما بعد الصلاة المشهورة."
    },
    "post_prayer_2": {
      "title": "ذكر بعد الصلاة 2",
      "text": "اللهم أنت السلام ومنك السلام تباركت يا ذا الجلال والإكرام",
      "source": "ذكر مشروع",
      "fadhl": "ذكر عظيم بعد الصلاة."
    },
    "post_prayer_3": {
      "title": "ذكر بعد الصلاة 3",
      "text": "سبحان الله، والحمد لله، والله أكبر",
      "source": "ذكر مشروع",
      "fadhl": "من الأذكار المشهورة عقب الصلاة."
    }
  },
